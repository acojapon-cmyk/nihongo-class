   photoshop:DateCreated="2009-11-10T08:42:03+00:00"
   photoshop:City="KAWASAKI"
   photoshop:Country="Japan"
   photoshop:TransmissionReference="TOK01"
   photoshop:Headline="To match Reuters Life! JAPAN-SNACK/"
   photoshop:Credit="REUTERS"
   photoshop:Source="X90018"
   photoshop:CaptionWriter="YN/AT"
   Iptc4xmpCore:CountryCode="JPN">
   <photoshop:SupplementalCategories>
