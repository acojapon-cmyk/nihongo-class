     <rdf:li>LIF FIN FOBE</rdf:li>
    </rdf:Bag>
   </photoshop:SupplementalCategories>
   <dc:title>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">JAPAN-SNACK/</rdf:li>
    </rdf:Alt>
   </dc:title>
   <dc:subject>
    <rdf:Bag>
     <rdf:li>:rel:d:bm:GF2E5BA0NSK01</rdf:li>
    </rdf:Bag>
   </dc:subject>
   <dc:description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">An employee makes a Japanese traditional snack called "Taiyaki", a baked pancake stuffed with a sweet bean jam, at a newly opened store of Fancy Corporation in Kawasaki, south of Tokyo October 23, 2009. Japan's economy may be stagnating, but sales of fish-shaped Taiyaki, which means baked sea bream, are going along swimmingly, thanks to its small price and auspicious name. Picture taken October 23, 2009. REUTERS/Yuriko Nakao (JAPAN SOCIETY BUSINESS FOOD)</rdf:li>
    </rdf:Alt>
   </dc:description>
   <dc:creator>
    <rdf:Seq>
     <rdf:li>YURIKO NAKAO</rdf:li>
    </rdf:Seq>
   </dc:creator>
  </rdf:Description>
 </rdf:RDF>
